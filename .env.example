# These go into Vercel Project Settings -> Environment Variables (not into a committed .env file)

# Password for the admin panel — change this to something only you know
ADMIN_PASSWORD=changeme

# From Upstash: dashboard.upstash.com -> your Redis database -> REST API section
# If you connect Upstash through Vercel's Storage/Marketplace tab, these two
# are added automatically and you can skip setting them by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
